{
  "manifest_version": 3,
  "name": "Recera",
  "version": "2.1.0",
  "description": "Recera — Precision assessment automation engine with autonomous live solving and batch question extraction.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Recera",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.adityauniversity.in/*",
        "*://*.technicalhub.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["widget.css"],
      "matches": ["*://*.adityauniversity.in/*", "*://*.technicalhub.io/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}